# Local development settings for the PostgreSQL service in compose.yml.
DATABASE_URL="postgresql://studyquest:studyquest@localhost:5432/studyquest?schema=public"
API_PORT=3001
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:3001
TRUSTED_PROXY_IPS=127.0.0.1,::1
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="StudyQuest <no-reply@studyquest.local>"
MAIL_REPLY_TO=admin@gtowell.dev
