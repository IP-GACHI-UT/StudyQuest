{
  "name": "studyquest",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "progress:build": "node scripts/check-runtime.cjs && node scripts/progress.mjs build",
    "progress:check": "node scripts/check-runtime.cjs && node scripts/progress.mjs check",
    "progress:serve": "node scripts/check-runtime.cjs && node scripts/progress.mjs serve",
    "dev:web": "node scripts/check-runtime.cjs && pnpm --filter @studyquest/web dev",
    "dev:api": "node scripts/check-runtime.cjs && pnpm --filter @studyquest/api dev",
    "test:api": "node scripts/check-runtime.cjs && pnpm --filter @studyquest/api test",
    "test:api:db": "node scripts/check-runtime.cjs && node scripts/run-api-db-test.mjs",
    "db:seed": "node scripts/check-runtime.cjs && node prisma/seed.js",
    "prisma:validate": "node scripts/check-runtime.cjs && prisma validate",
    "prisma:generate": "node scripts/check-runtime.cjs && prisma generate",
    "build:web": "node scripts/check-runtime.cjs && pnpm --filter @studyquest/web build",
    "build:api": "node scripts/check-runtime.cjs && pnpm --filter @studyquest/db build && pnpm --filter @studyquest/api build",
    "lint:web": "node scripts/check-runtime.cjs && pnpm --filter @studyquest/web lint",
    "typecheck:web": "node scripts/check-runtime.cjs && pnpm --filter @studyquest/web typecheck",
    "typecheck:api": "node scripts/check-runtime.cjs && pnpm --filter @studyquest/db typecheck && pnpm --filter @studyquest/api typecheck",
    "biome:check": "node scripts/check-runtime.cjs && biome check .",
    "biome:write": "node scripts/check-runtime.cjs && biome check --write .",
    "format": "node scripts/check-runtime.cjs && biome format --write .",
    "format:check": "node scripts/check-runtime.cjs && biome format .",
    "check:web": "node scripts/check-runtime.cjs && pnpm lint:web && pnpm typecheck:web && pnpm build:web && pnpm biome:check",
    "check:api": "node scripts/check-runtime.cjs && pnpm typecheck:api && pnpm build:api",
    "preinstall": "node scripts/check-runtime.cjs",
    "security:runtime": "node scripts/check-runtime.cjs",
    "test:security": "node scripts/check-runtime.cjs && node --test scripts/check-runtime.test.cjs"
  },
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.22.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  }
}
