{
  "name": "@studyquest/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/prisma.js",
  "types": "./src/prisma.ts",
  "exports": {
    ".": {
      "types": "./src/prisma.ts",
      "import": "./dist/prisma.js"
    },
    "./prisma": {
      "types": "./src/prisma.ts",
      "import": "./dist/prisma.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/check-runtime.cjs && tsc -p tsconfig.json",
    "typecheck": "node ../../scripts/check-runtime.cjs && tsc --noEmit",
    "check": "node ../../scripts/check-runtime.cjs && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  }
}
